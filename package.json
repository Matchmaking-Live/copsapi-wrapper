{
  "name": "copsapi-wrapper",
  "version": "1.0.0",
  "description": "Typed, quota-aware client for the Critical Ops Public API v2: profiles, leaderboards, match history, weapon stats, server status and autohosted custom games with a live room watcher.",
  "license": "MIT",
  "author": "Matchmaking Live",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matchmaking-Live/copsapi-wrapper.git"
  },
  "homepage": "https://github.com/Matchmaking-Live/copsapi-wrapper#readme",
  "bugs": {
    "url": "https://github.com/Matchmaking-Live/copsapi-wrapper/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "copsapi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "keywords": [
    "critical ops",
    "cops",
    "criticalops",
    "critical force",
    "api",
    "api-wrapper",
    "autohost",
    "esports",
    "matchmaking"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
